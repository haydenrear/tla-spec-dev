    "goals": [
      {
        "contribution": "direct",
        "expected_effect": "Two of the five known-unfalsifiable instruments -- the port-scoped positive control and its probe -- become capable of failing. If the probe still cannot fail, the goal's baseline is unchanged and the ticket says so.",
