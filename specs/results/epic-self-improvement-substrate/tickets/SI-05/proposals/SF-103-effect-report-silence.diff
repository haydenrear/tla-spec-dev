+    # file, and no reason. A requested report that cannot be produced now SAYS
+    # SO and names what it searched. This warns; it does not refuse.
     if effects_active:
         report = diff_effects(
             declarations,
             recorder.effects,
             cases=[point.case.name for point in points],
             case_actions=observed_case_actions,
             unobservable=recorder.unobservable,
         )
         if effect_report_path is not None:
             written = report.write(effect_report_path)
             print(f"wrote effect conformance report to {written}")
         print(report.render())
         if not report.ok:
             failures.append(f"effect conformance {report.verdict}:\n{report.render()}")
+    elif effect_report_path is not None:
+        # Requested but unproducible: say which declaration shapes were looked
+        # for, so the reader can tell "my project declares effects another way"
+        # from "the oracle is broken".
+        print(
+            f"no effect conformance report written to {effect_report_path}: "
