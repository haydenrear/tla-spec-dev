+    for source in [
+        "RerunGraphJbang.py",
+        "RerunGraphUv.py",
+        "RunOnlyJbang.py",
+        "RunOnlyUv.py",
+    ]:
+        assert (REPO_ROOT / "test_graph/sources" / source).exists()
