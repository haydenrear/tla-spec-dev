+def _scaffold_root(parent: Path) -> Path:
+    root = parent / "consumer" / "test_graph"
+    root.mkdir(parents=True)
+    (root / "settings.gradle.kts").write_text(
+        'rootProject.name = "fixture"\n', encoding="utf-8"
