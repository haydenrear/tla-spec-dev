+  \/ \E g \in Graphs, n \in Nodes:
+      ResolveNode(g, n)
+  \/ \E g \in Graphs:
+      PlanGraph(g)
+  \/ \E g \in Graphs:
+      StartRun(g)
+  \/ \E g \in Graphs, n \in Nodes:
