+\* @result WorkflowResult
+\* @port TestGraphProgramPort.rebuild_report
+RebuildReport(g) ==
+  /\ scaffolded
+  /\ g \in declared_graphs
+  /\ envelopes[g] /= {}
+  /\ run_reports' = run_reports \cup {g}
+  /\ result' = [accepted |-> TRUE, reason |-> NoReason]
