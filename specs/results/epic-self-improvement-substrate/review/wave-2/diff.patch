+
+class InputContextSnapshotAdapter(_DocumentedBoundaryAdapter):
+    boundary = "input_context_snapshots"
+    files = (
+        "project_sdk_sources/build-logic/src/main/kotlin/com/hayden/testgraphsdk/exec/Context.kt",
