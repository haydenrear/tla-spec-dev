+
+base_program_vars ==
+  << scaffolded, declared_graphs, explicit_nodes, script_deps, described_nodes,
+     dsl_deps, overlays, resolved_nodes, planned_graphs, plan_docs,
+     active_graphs, passed_nodes, terminal_nodes, envelopes, context_items,
