+            listOf(
+                "browser",
+                "db:writes",
+                "fs:tmp",
+                "net:external",
+                "net:local",
+                "process:gradle",
+                "environment:provision",
+                "environment:reuse",
+                "environment:deploy",
+                "environment:reset",
