+    real="$(cd "$dest" 2>/dev/null && pwd -P)" || real=""
+    case "$real" in
+      "$WTP"/*) : ;;
+      *) missing="$missing $u(resolves to ${real:-<nothing>})" ;;
+    esac
+  done
