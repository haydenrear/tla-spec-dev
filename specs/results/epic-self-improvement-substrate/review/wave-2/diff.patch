+    manifest = (SPEC_ROOT / "spec_manifest.yaml").read_text(encoding="utf-8")
+    executor = (
+        REPO_ROOT
+        / "project_sdk_sources/build-logic/src/main/kotlin/com/hayden/testgraphsdk/exec/PlanExecutor.kt"
+    ).read_text(encoding="utf-8")
