+  /\ n \notin passed_nodes[g]
+  /\ (n \notin envelopes[g] \/ n \in terminal_nodes[g])
+  /\ (n \notin terminal_nodes[g] \/ n \in rerunnable_nodes)
+  /\ MergedDeps(g, n) \subseteq passed_nodes[g]
+  /\ terminal_nodes' = [terminal_nodes EXCEPT ![g] = @ \cup {n}]
