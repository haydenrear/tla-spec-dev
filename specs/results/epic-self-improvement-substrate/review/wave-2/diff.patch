+  /\ envelopes' = [envelopes EXCEPT ![g] = @ \cup {n}]
+  /\ context_items' = [context_items EXCEPT ![g] = @ \cup {n}]
+  /\ input_contexts' = [input_contexts EXCEPT ![g] = @ \cup {n}]
