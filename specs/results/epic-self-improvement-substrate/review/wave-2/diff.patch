+  /\ g \in active_graphs
+  /\ resolved_nodes[g] /= {}
+  /\ resolved_nodes[g] \subseteq passed_nodes[g]
+  /\ run_reports' = run_reports \cup {g}
+  /\ active_graphs' = active_graphs \ {g}
+  /\ result' = [accepted |-> TRUE, reason |-> NoReason]
+  /\ UNCHANGED << scaffolded, declared_graphs, explicit_nodes, script_deps,
