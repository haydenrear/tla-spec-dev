+    tla = (SPEC_ROOT / "TestGraph.tla").read_text(encoding="utf-8")
+
+    for action in [
+        "SetNodeRerunDisabled",
+        "ResumeRunFromBuild",
+        "RunOnlyNodeFromBuild",
