+def test_program_model_contains_resumable_build_actions_and_invariants() -> None:
+    tla = (SPEC_ROOT / "TestGraph.tla").read_text(encoding="utf-8")
+
+    for action in [
+        "SetNodeRerunDisabled",
+        "ResumeRunFromBuild",
+        "RunOnlyNodeFromBuild",
