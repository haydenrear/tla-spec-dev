+        with self.assertRaisesRegex(
+            harness.ReplayEvidenceError, "not valid shell syntax"
+        ):
+            harness._bounded_gradle_env({"JAVA_OPTS": "'unterminated"})
+
+
+if __name__ == "__main__":
+    unittest.main()
