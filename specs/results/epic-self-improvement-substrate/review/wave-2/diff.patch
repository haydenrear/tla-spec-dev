+  /\ destroy_authorized_environments \subseteq AllBranchEnvironments
+  /\ destroyed_branch_environments \subseteq AllBranchEnvironments
+  /\ environment_context_keys \in [AllBranchEnvironments -> SUBSET ContextKeys]
