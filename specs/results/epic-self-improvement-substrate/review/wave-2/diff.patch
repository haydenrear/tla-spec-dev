+  /\ skipped_destroy_environments \cap destroyed_branch_environments = {}
+
+\* @invariant RuntimeContextVerificationIsTyped
+RuntimeContextVerificationIsTyped ==
+  runtime_environment_context_verified \subseteq NodeRuntimes
+
