@@ -0,0 +1,101 @@
+# Skill project manifest for git-issue-workflow.
+#
+# What this declares: the units an agent working IN THIS CHECKOUT needs. Every
+# tracked file here — SKILL.md, its frontmatter and description, references/,
+# skill-manager.toml — is skill-unit content, so the work done here is unit
+# authoring and the declared units are the authorities for that work.
+#
+# It deliberately does NOT declare `git-issue-workflow` itself. A repo is its
+# own source of truth; installing it into its own home would give an agent two
+# copies of the same skill with no rule about which one it is editing.
+#
+# How the home is produced — read this before running `project resolve`
+# ---------------------------------------------------------------------
+# `project resolve` writes into whatever `SKILL_MANAGER_HOME` names. Run it
+# before this checkout has its own home and it mutates the operator's global
+# ~/.skill-manager. Create the local home first, point `SKILL_MANAGER_HOME` at
+# it, and only then resolve:
+#
+# No `mkdir` first: bootstrap-home.sh creates the home, and `home clone`
+# requires an absent or empty destination, so pre-creating it breaks the very
+# first step (measured both ways: without --force it refuses a non-empty
+# directory; with --force it skips the clone and `home policy --live` then
+# refuses a directory that is not a home).
+#
+#   SKILL_MANAGER_CLI=<epic skill-manager> \
+#     bash scripts/bootstrap-home.sh --root "$PWD" --force
+#   export SKILL_MANAGER_HOME="$PWD/.skill-manager"
+#   skill-manager project resolve --project-dir "$PWD" --skip-gateway
+#
+# `SKILL_MANAGER_HOME` alone does not redirect the agent-home projections;
+# export `CLAUDE_CONFIG_DIR`, `CLAUDE_HOME`, `CODEX_HOME` and `GEMINI_HOME` at
+# this checkout's own `.claude/`, `.codex/` and `.gemini/` as well. Those are
+# the paths `home describe --json`'s `env` block names and the launch shims in
+# `.skill-manager/bin/launch/` export for you, which is why launching through a
+# shim is the supported way in.
+#
+# `--allow-same-home` is NOT needed. This project's home IS its own parent home,
+# and `project resolve` used to refuse that layout (skill-manager #32). The
+# refusal was wrong — it fired on the recipe's normal path — and has been
+# replaced by a warning naming the layout. The flag is still accepted and does
+# nothing.
+#
+# Coords are git-only (no registry is configured) and they name the REPO, not
+# the installed unit — see skill-publisher's references/coords-and-distribution.md.
+# The table key is the installed unit name, which is what
+# `.skill-manager/skills/<name>` uses.
+
+[project]
+name = "git-issue-workflow"
+version = "0.2.0"
+description = "Execute a git-issue work order in its selected mode: epic tickets branch from the declared origin/epic branch and promote one assigned spec ticket; unmarked tickets keep the ordinary/integration worktree, close-out, merge verification and fan-out."
+
+# --- authoring: skill-publisher is the authority on SKILL.md frontmatter, the
+#     description field, skill-manager.toml, references/ pages, and on the
+#     install/bind/sync round trip that ships an edit into a store ---
+
+[skills.unit-authoring]
+source = "github:haydenrear/skt"
+
+# --- required BY skill-publisher, not chosen here: its SKILL.md `skill-imports`
+#     names `skill-manager` (references/skill-imports.md), and `project resolve`
+#     refuses the whole resolve with "references missing unit" until the
+#     imported unit is declared. Unit `skill_references` are followed
+#     automatically; markdown `skill-imports` are not.
+#
+#     It is also the substantive dependency for THIS repo in particular: the
+#     ticket lifecycle documented here now has to say where a worktree's own
+#     `.skill-manager` home comes from and where `home close-out` sits before
+#     `git worktree remove` (issue #37), and `skill-manager` is the authority on
+#     both surfaces ---
+
+[skills.skill-manager]
+source = "github:haydenrear/skt"
+
+# --- REPO-SPECIFIC DECISION: git-issue, git-integration-repo,
+#     spec-double-compiler, test-graph and deploy-helm are deliberately NOT
+#     declared, though this unit's SKILL.md `skill-imports` names all five and
+#     skill-manager.toml lists four of them as hard `skill_references`.
+#
+#     Those are the skills this workflow DRIVES when it is executing a ticket in
+#     someone else's repository. They are not what an agent EDITING this
+#     workflow needs: this repo has no test_graph project, no specs/ tree, and
+#     no integration constituents — its tracked content is markdown. The
+#     `skill_references` exist so that INSTALLING git-issue-workflow elsewhere
+#     pulls the runtime set in; a project manifest answers the different
+#     question of what THIS checkout needs.
+#
+#     Confirmed empirically: `project resolve` validates `skill-imports` against
+#     INSTALLED units, and this repo's own unit is deliberately not installed
+#     into its own home, so its imports are not part of the resolve.
+#
+#     The cost of the other choice is not incidental. test-graph references
+#     `github:haydenrear/deploy-cdc`, so declaring any of test-graph,
+#     spec-double-compiler or deploy-helm transitively installs deploy-helm,
+#     whose three skill-script CLI dependencies each build a full ~555 MB venv.
+#     Measured across the onboarded homes: every home that pulls deploy-helm is
+#     ~1.8 GB; every home that does not is under 1 MB.
+
+# --- no [[vendored]] block: this repo tracks no symlinks and has no test_graph,
+#     so no path in the working tree holds content owned by another unit.
+#     Verified with `git ls-files -s | grep ^120000` -> 0 entries.
