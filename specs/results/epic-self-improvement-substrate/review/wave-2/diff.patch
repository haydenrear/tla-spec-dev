+\* @invariant TypeInvariant
+TypeInvariant ==
+  /\ scaffolded \in BOOLEAN
+  /\ declared_graphs \subseteq Graphs
+  /\ explicit_nodes \in [Graphs -> SUBSET SourceNodes]
+  /\ script_deps \in [SourceNodes -> SUBSET SourceNodes]
