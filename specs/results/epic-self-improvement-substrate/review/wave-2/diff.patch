+  /\ input_contexts' = [input_contexts EXCEPT ![g] = @ \cup {n}]
+  /\ rerun_guidance' =
+      [rerun_guidance EXCEPT ![g] =
+        IF n \in rerunnable_nodes THEN @ \cup {n} ELSE @ \ {n}]
