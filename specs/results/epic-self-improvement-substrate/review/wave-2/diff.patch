+  \/ \E g \in Graphs, b \in Branches,
+        target \in EnvironmentTargets, backend \in EnvironmentBackends:
+      RequestMergedBranchDestroy(g, b, target, backend)
+  \/ \E g \in Graphs, b \in Branches,
