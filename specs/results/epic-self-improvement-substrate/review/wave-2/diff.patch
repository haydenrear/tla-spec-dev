+SPECIFICATION Spec
+
+CONSTANTS
+  Graphs = {GraphA}
+  Nodes = {NodeA, NodeB}
+  Branches = {FeatureA}
+  EnvironmentTargets = {LocalDev}
+  EnvironmentBackends = {LocalOpenTofu}
+  ContextKeys = {KUBECONFIG, KUBECONTEXT, EnvironmentId}
+  RequiredEnvironmentContext = {KUBECONFIG, KUBECONTEXT, EnvironmentId}
+  Packages = {
+    SkillEntrypoint,
+    SkillScripts,
+    NodeTemplates,
+    WorkflowReferences,
+    GradlePlugin,
+    JavaSdk,
+    PythonSdk,
+    ExampleNodes,
+    SkillManifest
+  }
+  SourceNodes = {NodeA, NodeB}
+  NoReason = NoReason
+
+INVARIANTS
+  TypeInvariant
