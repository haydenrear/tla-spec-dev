+  \/ \E g \in Graphs, n \in Nodes:
+      RunNodeTerminal(g, n)
+  \/ \E g \in Graphs:
+      WriteInlineReport(g)
+  \/ \E g \in Graphs:
+      RebuildReport(g)
+  \/ CleanBuild
+  \/ NoOp
