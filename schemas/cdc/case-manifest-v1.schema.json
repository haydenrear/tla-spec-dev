{
  "$id": "https://haydenrear.github.io/tla-spec-dev/schemas/cdc/case-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDC CaseManifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cdc.case-manifest.v1"
    },
    "case_schema_version": {
      "const": "cdc.case-envelope.v1"
    },
    "protocol_version": {
      "const": "cdc.tlc-case-stream.v1"
    },
    "source_module": {
      "type": "string",
      "minLength": 1
    },
    "view": {
      "enum": [
        "internal",
        "external",
        "pipeline-internal",
        "pipeline-external"
      ]
    },
    "tier": {
      "enum": [
        "gold",
        "model",
        "fuzz"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "budget_outcome": {
      "$ref": "#/$defs/budgetOutcome"
    },
    "selection_policy": {
      "const": "stable-hash-stratified"
    },
    "seed": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "spec_digest": {
      "$ref": "#/$defs/digest"
    },
    "module_digest": {
      "$ref": "#/$defs/digest"
    },
    "config_digest": {
      "$ref": "#/$defs/digest"
    },
    "projection_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_digests": {
      "$ref": "#/$defs/sourceDigests"
    },
    "state_count": {
      "type": "integer",
      "minimum": 0
    },
    "observed_transition_count": {
      "type": "integer",
      "minimum": 0
    },
    "eligible_transition_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "staged_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "emitted_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "staged_output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "total_output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "cases_path": {
      "type": "string",
      "minLength": 1
    },
    "cases_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "strata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "resource_usage": {
      "$ref": "#/$defs/resourceUsage"
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_source_commit": {
      "type": "string",
      "minLength": 1
    },
    "source_tree_dirty": {
      "type": "boolean"
    },
    "expected_result_count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "case_schema_version",
    "protocol_version",
    "source_module",
    "view",
    "tier",
    "complete",
    "status",
    "budget_outcome",
    "selection_policy",
    "seed",
    "budgets",
    "spec_digest",
    "module_digest",
    "config_digest",
    "projection_digest",
    "state_count",
    "observed_transition_count",
    "eligible_transition_count",
    "candidate_case_count",
    "selected_case_count",
    "staged_case_count",
    "emitted_case_count",
    "output_bytes",
    "total_output_bytes",
    "cases_path",
    "cases_digest",
    "resource_usage",
    "manifest_digest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "cases_digest": {
            "$ref": "#/$defs/digest"
          },
          "budget_outcome": {
            "oneOf": [
              {
                "$ref": "#/$defs/withinBudget"
              },
              {
                "$ref": "#/$defs/boundedSelection"
              }
            ]
          }
        },
        "required": [
          "strata"
        ]
      },
      "else": {
        "properties": {
          "status": {
            "const": "incomplete"
          },
          "cases_digest": {
            "type": "null"
          },
          "budget_outcome": {
            "$ref": "#/$defs/budgetExceeded"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cases": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_rss_mib": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "per_case_timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_cases",
        "max_output_bytes",
        "max_rss_mib",
        "max_seconds",
        "per_case_timeout_ms"
      ]
    },
    "sourceDigests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/digest"
        },
        "module": {
          "$ref": "#/$defs/digest"
        },
        "config": {
          "$ref": "#/$defs/digest"
        },
        "projection": {
          "$ref": "#/$defs/digest"
        },
        "dot": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "spec",
        "module",
        "config",
        "projection"
      ]
    },
    "withinBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "within_budget"
        }
      },
      "required": [
        "type"
      ]
    },
    "boundedSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bounded_selection"
        },
        "budget": {
          "const": "max_cases"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "budget",
        "limit",
        "observed"
      ]
    },
    "budgetExceeded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "budget_exceeded"
        },
        "budget": {
          "enum": [
            "max_output_bytes",
            "max_rss_mib",
            "max_seconds"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "budget",
        "limit",
        "observed",
        "stage"
      ]
    },
    "budgetOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/withinBudget"
        },
        {
          "$ref": "#/$defs/boundedSelection"
        },
        {
          "$ref": "#/$defs/budgetExceeded"
        }
      ]
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "candidate_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_case_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "action",
        "outcome",
        "candidate_case_count",
        "selected_case_count",
        "emitted_case_count"
      ]
    },
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "elapsed_ms",
        "peak_rss_bytes"
      ]
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/countMap"
        },
        "outcome": {
          "$ref": "#/$defs/countMap"
        },
        "tier": {
          "$ref": "#/$defs/countMap"
        }
      },
      "required": [
        "action",
        "outcome",
        "tier"
      ]
    }
  }
}
